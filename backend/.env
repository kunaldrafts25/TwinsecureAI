# =============================================================================
# TwinSecure AI Backend - Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!


# =============================================================================
# Application Settings
# =============================================================================
PROJECT_NAME=TwinSecure AI Backend
PROJECT_DESCRIPTION=Advanced Cybersecurity Platform with AI-Powered Threat Detection
VERSION=1.0.0
API_V1_STR=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO


# =============================================================================
# Security & Authentication
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First Superuser (REQUIRED: Change in production!)
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe!123456

# Password Requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
PASSWORD_PATTERN=^(?=.*[A-Za-z])(?=.*\d)(?=.*[@$!%*#?&])[A-Za-z\d@$!%*#?&]{12,}$

# Session & CSRF Settings
SESSION_COOKIE_NAME=twinsecure_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

CSRF_COOKIE_NAME=twinsecure_csrf
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true
CSRF_COOKIE_SAMESITE=Lax

# JWT Blacklist
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_TOKEN_CHECKS=access,refresh


# =============================================================================
# Database (PostgreSQL)
# =============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=twinsecure
# Auto-generated, no need to set manually:
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}


# =============================================================================
# Redis Cache
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_in_production
REDIS_DB=0
# Auto-generated:
# REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PREFIX=twinsecure:


# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_ML=true
ENABLE_ALERTING=true
ENABLE_METRICS=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_ML_TRAINING=false


# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute


# =============================================================================
# CORS Origins (Comma-separated)
# =============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]


# =============================================================================
# Email (SMTP) Configuration
# =============================================================================
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=TwinSecure AI


# =============================================================================
# Alert Recipients (JSON array format)
# =============================================================================
ALERT_RECIPIENTS=["security@example.com"]


# =============================================================================
# Slack Integration (Optional)
# =============================================================================
SLACK_WEBHOOK_URL=


# =============================================================================
# Discord Integration (Optional)
# =============================================================================
DISCORD_WEBHOOK_URL=


# =============================================================================
# IP Enrichment Services
# =============================================================================
# AbuseIPDB (Optional - Get key from https://www.abuseipdb.com)
ABUSEIPDB_API_KEY=

# MaxMind GeoIP2 (Get key from https://www.maxmind.com/en/geolite2/signup)
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./GeoLite2-City.mmdb


# =============================================================================
# File Storage Paths
# =============================================================================
REPORTS_DIR=reports
LOGS_DIR=logs
DATA_DIR=data
ML_MODELS_DIR=models


# =============================================================================
# Machine Learning
# =============================================================================
ML_MODEL_PATH=models/autoencoder.h5
ML_TRAINING_SCHEDULE=0 2 * * *


# =============================================================================
# AWS Configuration (Optional)
# =============================================================================
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_S3_BUCKET=twinsecure-reports
