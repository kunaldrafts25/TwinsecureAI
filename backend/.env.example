# =============================================================================
# TwinSecure AI Backend - Environment Configuration Template
# =============================================================================
# Copy this file to .env and update with your actual values.
# NEVER commit .env or any secrets to version control!
#
# Required variables must be set before starting the application.
# Optional variables can be left empty if the feature is not needed.
# =============================================================================


# =============================================================================
# APPLICATION SETTINGS (Required)
# =============================================================================
PROJECT_NAME=TwinSecure AI Backend
PROJECT_DESCRIPTION=Advanced Cybersecurity Platform with AI-Powered Threat Detection
VERSION=1.0.0
API_V1_STR=/api/v1

# Environment: development, staging, or production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO


# =============================================================================
# SECURITY & AUTHENTICATION (Required)
# =============================================================================
# Generate a random secret key: openssl rand -hex 32
# For production, use a strong random value from your secret manager
SECRET_KEY=your_random_secret_key_here_minimum_32_characters

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# First admin user credentials (CHANGE THESE IN PRODUCTION)
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=ChangeMe!123456

# Password requirements
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# Session security
SESSION_COOKIE_NAME=twinsecure_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# CSRF protection
CSRF_COOKIE_NAME=twinsecure_csrf
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=true
CSRF_COOKIE_SAMESITE=Lax

# JWT blacklist
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_TOKEN_CHECKS=access,refresh


# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================
# PostgreSQL connection details
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=twinsecure

# Database pool settings
POOL_SIZE=20
MAX_OVERFLOW=10
POOL_TIMEOUT=30
POOL_RECYCLE=1800


# =============================================================================
# REDIS CACHE (Optional but recommended)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PREFIX=twinsecure:


# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_ML=true
ENABLE_ALERTING=true
ENABLE_METRICS=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true


# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute


# =============================================================================
# CORS ORIGINS (Comma-separated or JSON array)
# =============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:5173"]


# =============================================================================
# EMAIL/SMTP CONFIGURATION (Optional)
# =============================================================================
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.example.com
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@example.com
EMAILS_FROM_NAME=TwinSecure AI

# Alert recipients (JSON array format)
ALERT_RECIPIENTS=["security@example.com"]


# =============================================================================
# SLACK INTEGRATION (Optional)
# =============================================================================
# Get webhook URL from: https://api.slack.com/apps
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#security-alerts


# =============================================================================
# DISCORD INTEGRATION (Optional)
# =============================================================================
# Get webhook URL from Discord server settings
DISCORD_WEBHOOK_URL=


# =============================================================================
# IP ENRICHMENT & THREAT INTELLIGENCE (Optional)
# =============================================================================
# AbuseIPDB API (Optional - https://www.abuseipdb.com)
ABUSEIPDB_API_KEY=
ABUSEIPDB_API_URL=https://api.abuseipdb.com/api/v2/check

# MaxMind GeoIP2 (Optional - https://www.maxmind.com/en/geolite2/signup)
MAXMIND_LICENSE_KEY=
MAXMIND_DB_PATH=./GeoLite2-City.mmdb


# =============================================================================
# AWS CONFIGURATION (Optional)
# =============================================================================
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key


# =============================================================================
# FILE STORAGE PATHS
# =============================================================================
REPORTS_DIR=reports
LOGS_DIR=logs
DATA_DIR=data
ML_MODELS_DIR=models


# =============================================================================
# MACHINE LEARNING (Optional)
# =============================================================================
ENABLE_ML=true
ML_MODEL_PATH=models/autoencoder.h5
ML_TRAINING_SCHEDULE=0 2 * * *
ML_BATCH_SIZE=32
ML_LEARNING_RATE=0.001
ML_EPOCHS=100


# =============================================================================
# HONEYPOT CONFIGURATION
# =============================================================================
# Optional: Secure honeypot endpoint with a secret header
# HONEYPOT_SECRET_HEADER=your-secret-honeypot-key


# =============================================================================
# PROMETHEUS MONITORING (Optional)
# =============================================================================
ENABLE_PROMETHEUS=true
METRICS_PORT=9090
